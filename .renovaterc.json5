{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#10.0.1",
    // apps/ presets are opt-in and need their own tag, they do not inherit the one above
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#10.0.1",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#10.0.1",
  ],
  schedule: ["every weekend"],
  // ghcr.io / quay.io carry no releaseTimestamp, which parks them forever
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // override :automergeBranch from the preset, flate and konflate only report on PRs
  automergeType: "pr",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["every weekend"],
  },
  // Images pulled through the apoci cache are looked up at their origin
  registryAliases: {
    "registry.nilsit.de/docker.io": "docker.io",
    "registry.nilsit.de/ghcr.io": "ghcr.io",
    "registry.nilsit.de/quay.io": "quay.io",
    "registry.nilsit.de/mirror.gcr.io": "mirror.gcr.io",
    "registry.nilsit.de/dock.mau.dev": "dock.mau.dev",
    "registry.nilsit.de/git.sable.moe": "git.sable.moe",
    "registry.nilsit.de/forgejo.ellis.link": "forgejo.ellis.link",
  },
  customManagers: [
    {
      description: "apoci dashboard, the tag sits inside the Forgejo raw URL",
      customType: "regex",
      managerFilePatterns: ["/kubernetes/apps/apoci/apoci/app/grafanadashboard\\.yaml$/"],
      matchStrings: [
        "git\\.ow-ops\\.eu/(?<depName>ow-ops/apoci)/raw/tag/(?<currentValue>v[^/]+)/",
      ],
      datasourceTemplate: "forgejo-tags",
      registryUrlTemplate: "https://git.ow-ops.eu",
    },
    {
      description: "Annotated dependencies with a trailing versioning=, which the preset's annotation regex does not match",
      customType: "regex",
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      datasourceTemplate: "{{{datasource}}}",
      versioningTemplate: "{{{versioning}}}",
    },
    {
      description: "Commit pins annotated with the branch they track, which the preset's annotation regex does not match",
      customType: "regex",
      managerFilePatterns: ["/(^|/)Dockerfile$/", "/containers/paseo/rootfs/etc/xdg/nvim/init\\.lua$/"],
      matchStrings: [
        "datasource=git-refs depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\n[^\\n]*?(?<currentDigest>[0-9a-f]{40})",
      ],
      datasourceTemplate: "git-refs",
    },
    {
      description: "grafana-operator CRDs, the tag sits inside the GitHub release download URL",
      customType: "regex",
      managerFilePatterns: ["/kubernetes/apps/observability/grafana/crds/kustomization\\.yaml$/"],
      matchStrings: [
        "github\\.com/(?<depName>grafana/grafana-operator)/releases/download/(?<currentValue>v[^/]+)/",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      description: "dragonfly-operator dashboard, the tag sits inside the raw.githubusercontent.com URL",
      customType: "regex",
      managerFilePatterns: ["/kubernetes/apps/database/dragonfly/app/grafanadashboard\\.yaml$/"],
      matchStrings: [
        "raw\\.githubusercontent\\.com/(?<depName>dragonflydb/dragonfly-operator)/(?<currentValue>v[^/]+)/",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      description: "Paseo Neovim plugin tags and Mason package versions, Lua's `key = 'value'` spacing is beyond the preset's annotation regex",
      customType: "regex",
      managerFilePatterns: ["/containers/paseo/rootfs/etc/xdg/nvim/init\\.lua$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n]*?(tag|version) = '(?<currentValue>[^']+)'",
      ],
    },
    {
      description: "As above, for versions that need an explicit versioning",
      customType: "regex",
      managerFilePatterns: ["/containers/paseo/rootfs/etc/xdg/nvim/init\\.lua$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\n[^\\n]*?(tag|version) = '(?<currentValue>[^']+)'",
      ],
      versioningTemplate: "{{{versioning}}}",
    },
    {
      description: "Immich machine-learning tag follows the immich release, its ghcr tag list is too large to page through",
      customType: "regex",
      managerFilePatterns: ["/kubernetes/apps/immich/immich/app/helmrelease\\.yaml$/"],
      matchStrings: [
        "repository: (registry\\.nilsit\\.de/)?ghcr\\.io/immich-app/immich-machine-learning\\n(\\s*#.*\\n)*\\s*tag: (?<currentValue>v\\d+\\.\\d+\\.\\d+)-openvino",
      ],
      depNameTemplate: "immich-app/immich",
      datasourceTemplate: "github-releases",
    },
  ],
  packageRules: [
    // ---------------------------------------------------------------------
    // Groups: things that share a version and must move in lockstep
    // ---------------------------------------------------------------------
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "ARC Group: controller and scale set charts must match",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/actions-runner-controller-charts/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Talos Group: topf.yaml and the TalosUpgrade CR",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Kubernetes Group: topf.yaml, the KubernetesUpgrade CR and the kubectl CLI",
      groupName: "kubernetes",
      matchPackageNames: ["ghcr.io/siderolabs/kubelet", "mirror.gcr.io/alpine/k8s"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "FerretDB Group: FerretDB and its DocumentDB Postgres image",
      groupName: "ferretdb",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/ferretdb/ferretdb", "ghcr.io/ferretdb/postgres-documentdb"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Garage Group: the NAS, the Unraid node and the edge gateways must run the same version",
      groupName: "garage",
      matchDatasources: ["docker"],
      matchPackageNames: ["/dxflrs/garage$/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "SFTPGo Group: the -slim init container copies static files the -distroless-slim app serves",
      groupName: "sftpgo",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/drakkan/sftpgo"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group: kubectl is pinned to the cluster version",
      groupName: "kubernetes",
      matchManagers: ["mise"],
      matchDepNames: ["kubectl"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Talos Group: talosctl is pinned to the cluster version",
      groupName: "talos",
      matchManagers: ["mise"],
      matchDepNames: ["talosctl"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "apoci Group: the image and the dashboard pinned to the matching tag",
      groupName: "apoci",
      matchPackageNames: ["git.ow-ops.eu/ow-ops/apoci", "ow-ops/apoci"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "grafana-operator Group: the chart and the CRDs applied ahead of it",
      groupName: "grafana-operator",
      matchPackageNames: ["ghcr.io/grafana/helm-charts/grafana-operator", "grafana/grafana-operator"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "dragonfly-operator Group: the chart and the dashboard pinned to the matching tag",
      groupName: "dragonfly-operator",
      matchPackageNames: ["ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator", "dragonflydb/dragonfly-operator"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Rook Ceph Group: operator chart, cluster chart and operator image",
      groupName: "rook-ceph",
      matchPackageNames: ["/^ghcr.io/rook//"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Scanopy Group: server and daemon images must match",
      groupName: "scanopy",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/scanopy/scanopy/server", "ghcr.io/scanopy/scanopy/daemon"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "VictoriaMetrics Group: the k8s-stack chart and the pinned vmsolar image",
      groupName: "victoria-metrics",
      matchPackageNames: [
        "ghcr.io/victoriametrics/helm-charts/victoria-metrics-k8s-stack",
        "docker.io/victoriametrics/victoria-metrics",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "deadvalues Group: the GitHub Action and the mise CLI the workflow reads its version from",
      groupName: "deadvalues",
      matchPackageNames: ["guarnz/deadvalues"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Paseo Group: every dependency baked into the image, majors included, in one auto-merged PR a week so the image rebuilds once. A bump that breaks the bake fails the image build on main and the cluster keeps the last image",
      groupName: "paseo",
      matchFileNames: ["containers/paseo/**"],
      separateMajorMinor: false,
      automerge: true,
      schedule: ["before 6am on saturday"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    // ---------------------------------------------------------------------
    // Disabled lookups
    // ---------------------------------------------------------------------
    {
      description: "Immich machine-learning image is bumped via the immich-app/immich custom manager",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/immich-app/immich-machine-learning"],
      enabled: false,
    },
    {
      description: "dvinyl's grants Job takes its tag from PG_IMAGE_TAG in ks.yaml, the kubernetes manager sees no tag and would pin latest's digest",
      matchManagers: ["kubernetes"],
      matchPackageNames: ["ghcr.io/ferretdb/postgres-documentdb"],
      enabled: false,
    },
    {
      description: "node-healthcheck-operator v5.x tags are rebuilt from upstream main and their old digests are deleted",
      matchDatasources: ["docker"],
      matchPackageNames: ["quay.io/medik8s/node-healthcheck-operator"],
      allowedVersions: "<5",
    },
    // ---------------------------------------------------------------------
    // Digests
    // ---------------------------------------------------------------------
    {
      description: "Pin container images without a digest, flux is left out as it would write the digest into an OCIRepository ref.tag",
      matchDatasources: ["docker"],
      matchManagers: ["helm-values", "kubernetes", "docker-compose", "dockerfile"],
      pinDigests: true,
    },
    {
      description: "Don't chase a new digest for an unchanged tag, version bumps still carry the new digest. lancachenet only publish latest, so the digest is all that can move",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["!/lancachenet//", "!registry.nilsit.de/nilsit.de/paseo"],
      enabled: false,
    },
    // ---------------------------------------------------------------------
    // Auto-merge
    // ---------------------------------------------------------------------
    {
      description: "Auto-merge patch updates",
      matchUpdateTypes: ["patch"],
      automerge: true,
    },
    {
      description: "Auto-merge minor updates, zer0ver 0.x minors can break at any time",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^v?0\\./",
      automerge: true,
    },
    {
      description: "Auto-merge Paseo image rebuilds, containers/paseo pushes each one under the same tag",
      matchDatasources: ["docker"],
      matchPackageNames: ["registry.nilsit.de/nilsit.de/paseo"],
      matchUpdateTypes: ["digest"],
      automerge: true,
      schedule: ["at any time"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
    },
    // ---------------------------------------------------------------------
    // Never auto-merge: storage and cluster upgrades stay hands-on
    // ---------------------------------------------------------------------
    {
      description: "Never auto-merge Rook / Ceph, csi-drivers manifests are vendored",
      matchPackageNames: ["/rook/", "/ceph/"],
      automerge: false,
    },
    {
      description: "Never auto-merge Talos / Kubernetes, they roll out via tuppr",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/kubelet"],
      automerge: false,
    },
    {
      description: "Never auto-merge Coraza, the composer module inspects every public request",
      matchPackageNames: ["ghcr.io/tetratelabs/built-on-envoy/composer"],
      automerge: false,
    },
    {
      description: "Never auto-merge Envoy Gateway minors, each bundles an Envoy minor the composer module must support",
      matchPackageNames: ["/envoyproxy/gateway-helm/"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },
    {
      description: "Never auto-merge Multus, every pod's sandbox creation delegates through its shim",
      matchPackageNames: ["ghcr.io/k8snetworkplumbingwg/multus-cni"],
      automerge: false,
    },
    {
      description: "Auto-merge only patch updates of the TimescaleDB extension image, the timescale-bootstrap Job runs the ALTER EXTENSION on rollout",
      matchPackageNames: ["ghcr.io/xnilsit/timescaledb-cnpg"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },
    {
      description: "Never auto-merge kubectl / talosctl, they are pinned to the cluster version",
      matchManagers: ["mise"],
      matchDepNames: ["kubectl", "talosctl"],
      automerge: false,
    },
    {
      description: "Never auto-merge the authentik provider, it writes to a shared authentik and needs `tofu providers lock` plus a plan",
      matchDatasources: ["terraform-provider"],
      matchPackageNames: ["goauthentik/authentik"],
      automerge: false,
    },
    // ---------------------------------------------------------------------
    // Labels
    // ---------------------------------------------------------------------
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
    {
      matchDatasources: ["terraform-provider"],
      addLabels: ["renovate/terraform"],
    },
  ],
}
