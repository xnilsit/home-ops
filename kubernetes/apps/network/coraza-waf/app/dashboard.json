{
  "title": "Coraza WAF",
  "uid": "coraza-waf",
  "tags": [
    "network",
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "gateway",
        "label": "Gateway",
        "type": "custom",
        "query": "envoy-external,envoy-external-direct",
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "How to read this",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Coraza's own `[hostname \"...\"]` is the envoy pod IP**, not the site that was attacked - it is the server address of the connection. The requested host comes from local rule `10020`, which emits one extra line per flagged request carrying `host=` and the anomaly score. It shares the transaction's `unique_id` with the rule alerts, which is how the panels below join the two.\n\n**`[client \"...\"]` is the TCP peer** - a cloudflared pod IP on `envoy-external`. The real client is the first element of `x-forwarded-for` on the matching access-log line.\n\n**In `SecRuleEngine DetectionOnly` the Prometheus panels stay flat at zero** - `waf_filter.tx.interruptions` only counts an actual interrupt. The log panels are the truth during the detection soak.\n\nRule `949110`/`949111` is the CRS anomaly evaluation: a hit there is a request that *would* be blocked once the engine is flipped to `On`. LAN sources are exempted by local rules 10001/10002 and never appear here."
      }
    },
    {
      "type": "stat",
      "title": "Detections",
      "description": "Coraza alert lines in the selected range.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${DS_VICTORIALOGS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "stats",
          "expr": "kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" _msg:Coraza -\"WAF request context\" | stats count() hits"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Would be blocked",
      "description": "CRS rule 949110 - inbound anomaly score over threshold.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${DS_VICTORIALOGS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "stats",
          "expr": "kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" _msg:Coraza -\"WAF request context\" | extract '[id \"<rule_id>\"]' | filter rule_id:=\"949110\" or rule_id:=\"949111\" | stats count() hits"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Hosts attacked",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${DS_VICTORIALOGS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "stats",
          "expr": "kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" \"WAF request context\" | extract '[data \"host=<host> score=<score>\"]' | stats count_uniq(host) hosts"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Requests inspected /s",
      "description": "Every transaction the wasm VM saw, including allowlisted ones. Envoy Gateway emits coraza's proxy-wasm counters unprefixed, not under envoy_wasmcustom_.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(waf_filter_tx_total[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Detections over time by rule",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${DS_VICTORIALOGS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "statsRange",
          "step": "$__interval",
          "legendFormat": "{{rule_id}}",
          "expr": "kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" _msg:Coraza -\"WAF request context\" | extract '[id \"<rule_id>\"]' | stats by (rule_id) count() hits"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top rules - the false-positive tuning list",
      "description": "Work this to zero legitimate hits before flipping SecRuleEngine to On.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${DS_VICTORIALOGS}"
      },
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "host"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rule_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hits"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "hits",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "stats",
          "format": "table",
          "expr": "kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" _msg:Coraza -\"WAF request context\" | extract '[id \"<rule_id>\"]' | extract '[msg \"<msg>\"]' | extract '[unique_id \"<uid>\"]' | join by (uid) (kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" \"WAF request context\" | extract '[data \"host=<host> score=<score>\"]' | extract '[unique_id \"<uid>\"]' | fields uid, host) | stats by (host, rule_id, msg) count() hits | sort by (hits desc) | limit 25"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "hits"
            },
            "indexByName": {
              "host": 0,
              "rule_id": 1,
              "msg": 2,
              "hits": 3
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "type": "table",
      "title": "Top attacked hosts and paths",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${DS_VICTORIALOGS}"
      },
      "gridPos": {
        "h": 11,
        "w": 10,
        "x": 14,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "host"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hits"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "hits",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "stats",
          "format": "table",
          "expr": "kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" _msg:Coraza -\"WAF request context\" | extract '[uri \"<uri>\"]' | extract '[unique_id \"<uid>\"]' | join by (uid) (kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" \"WAF request context\" | extract '[data \"host=<host> score=<score>\"]' | extract '[unique_id \"<uid>\"]' | fields uid, host) | stats by (host, uri) count() hits | sort by (hits desc) | limit 25"
        }
      ],
      "description": "Joined to rule 10020's context line on unique_id, so the host is the one the client asked for.",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "hits"
            },
            "indexByName": {
              "host": 0,
              "uri": 1,
              "hits": 2
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "type": "table",
      "title": "Top external source addresses (all requests)",
      "description": "First element of x-forwarded-for, i.e. the real client. In-cluster and LAN sources are filtered out. Watch for the home WAN IP: those are LAN devices bypassing blocky, and they are not exempted by rules 10001/10002.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${DS_VICTORIALOGS}"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "hits"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "hits",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "stats",
          "format": "table",
          "expr": "kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" | extract_regexp \"^(?P<client_ip>[^,]+)\" from \"x-forwarded-for\" | filter NOT client_ip:=\"\" AND NOT client_ip:~\"^(10[.]|192[.]168[.]|172[.](1[6-9]|2[0-9]|3[01])[.]|127[.]|fd2e|::1)\" | stats by (client_ip) count() hits | sort by (hits desc) | limit 25"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "hits"
            },
            "indexByName": {
              "client_ip": 0,
              "hits": 1
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Interruptions by rule - blocking mode only",
      "description": "Flat at zero while SecRuleEngine is DetectionOnly. Labels come from the stats_config.stats_tags patch on EnvoyProxy/envoy-waf.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          },
          "noValue": "0 - nothing is blocked while SecRuleEngine is DetectionOnly"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{rule_id}} / {{phase}}",
          "expr": "sum by (rule_id, phase) (rate(waf_filter_tx_interruptions[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent decisions",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${DS_VICTORIALOGS}"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "maxLines": 200,
          "expr": "kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" _msg:Coraza -\"WAF request context\" | extract '[id \"<rule_id>\"]' | extract '[msg \"<msg>\"]' | extract '[severity \"<severity>\"]' | extract '[uri \"<uri>\"]' | extract '[client \"<client>\"]' | extract '[unique_id \"<uid>\"]' | join by (uid) (kubernetes.pod_namespace:network kubernetes.pod_labels.gateway.envoyproxy.io/owning-gateway-name:~\"^$gateway$\" \"WAF request context\" | extract '[data \"host=<host> score=<score>\"]' | extract '[unique_id \"<uid>\"]' | fields uid, host) | fields _time, host, uri, rule_id, msg, severity, client"
        }
      ],
      "description": "host comes from rule 10020's context line, joined on unique_id. The datasource returns a logs frame, so the fields arrive inside a JSON labels column and are split out by the extractFields transformation.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "host"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rule_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "client"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 155
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {},
            "indexByName": {
              "Time": 0,
              "host": 1,
              "uri": 2,
              "severity": 3,
              "client": 4,
              "msg": 5,
              "rule_id": 6
            }
          }
        }
      ]
    }
  ]
}
