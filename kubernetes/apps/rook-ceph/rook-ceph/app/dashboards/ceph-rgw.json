      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(ceph_pool_stored * on(pool_id) group_left(name)\n  ceph_pool_metadata{name=\"ceph-objectstore.rgw.buckets.data\"})",
          "range": false,
          "instant": true,
          "refId": "A",
          "legendFormat": "stored"
        }
      ],
      "description": "Logical bytes in the object store's data pool, before 3x replication."
