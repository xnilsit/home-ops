    {
      "id": 9,
      "type": "timeseries",
      "title": "Request rate per gateway",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_replace(\n  sum by(pod) (rate(ceph_rgw_req{job=\"rook-ceph-exporter\"}[$__rate_interval])),\n  \"node\", \"$1\", \"pod\", \"rook-ceph-exporter-(.*)-[^-]+-[^-]+\")",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "description": "Labelled by the node whose ceph-exporter reports it. Both gateway pods carry ceph_daemon rgw.ceph.objectstore.a, so the node is the only thing that tells them apart."
    },
