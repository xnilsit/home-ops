          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "available"
        }
      ],
      "description": "cluster_available: every partition still has a read/write quorum. 0 means the S3 API is failing requests."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Partitions all-OK",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {},
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * cluster_partitions_all_ok{job=\"garage\"} / cluster_partitions{job=\"garage\"}",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "all ok"
        }
      ],
      "description": "Share of the 256 partitions whose nodes are all up. The quorum share is plotted next to it."
