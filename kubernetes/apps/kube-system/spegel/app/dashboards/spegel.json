          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"spegel\", handler=\"/v2/*\", method=\"GET\"}[$__rate_interval]) * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info{namespace=\"kube-system\", created_by_name=\"spegel\", node=~\"$node\"})))",
          "legendFormat": "p50",
