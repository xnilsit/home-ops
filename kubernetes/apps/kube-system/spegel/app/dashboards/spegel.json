          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (node) (increase(spegel_mirror_requests_total{job=\"spegel\", cache=\"hit\"}[$__range]) * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info{namespace=\"kube-system\", created_by_name=\"spegel\", node=~\"$node\"})) / sum by (node) (increase(spegel_mirror_requests_total{job=\"spegel\"}[$__range]) * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info{namespace=\"kube-system\", created_by_name=\"spegel\", node=~\"$node\"}))",
          "legendFormat": "{{node}}",
          "range": false,
          "instant": true,
          "refId": "A"
