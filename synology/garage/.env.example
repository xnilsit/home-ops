# Copy to .env (gitignored) next to docker-compose.yaml on the NAS.
# The same two values live in the cluster as
# kubernetes/apps/garage/garage/app/secret.sops.yaml - they must match byte for
# byte or the operator cannot talk to Garage and derived GarageKeys break.
#
#   openssl rand -hex 32      # GARAGE_RPC_SECRET - must be 32-byte hex
#   openssl rand -base64 32   # GARAGE_ADMIN_TOKEN
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
